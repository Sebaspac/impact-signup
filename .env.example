# Impact Fight Academy — Anmeldesystem
# Kopieren nach .env.local und ausfüllen. .env* ist in .gitignore, diese Datei
# hier enthält bewusst nur Platzhalter und niemals echte Schlüssel.

# --- Supabase (Projekt-Einstellungen > API) ---
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# service_role-Key: umgeht Row Level Security. NIEMALS im Browser verwenden,
# niemals in eine NEXT_PUBLIC_-Variable schreiben, niemals committen.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Entwickler > API-Schlüssel) ---
# Für Tests sk_test_..., erst nach Freigabe der echten Preise auf sk_live_... wechseln.
STRIPE_SECRET_KEY=sk_test_
# Aus "stripe listen --forward-to localhost:3000/api/stripe-webhook",
# in Produktion aus dem Webhook-Endpunkt im Stripe-Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_

# --- Stripe Price IDs ---
# ACHTUNG: Die Preise müssen den vom Inhaber freigegebenen Beträgen aus
# INHALT_PREISE.md entsprechen. Siehe README, Abschnitt "Preise".
STRIPE_PRICE_ERWACHSEN_6=price_
STRIPE_PRICE_ERWACHSEN_12=price_
STRIPE_PRICE_JUGEND_6=price_
STRIPE_PRICE_JUGEND_12=price_
STRIPE_PRICE_KIND_6=price_
STRIPE_PRICE_KIND_12=price_
# Einmalige Aufnahmegebühr (50 €), entfällt bei Vorauszahlung
STRIPE_PRICE_AUFNAHMEGEBUEHR=price_

# --- Resend (E-Mail-Versand) ---
RESEND_API_KEY=re_
# Für den echten Betrieb eine bei Resend verifizierte eigene Domain verwenden.
EMAIL_FROM=Impact Fight Academy <noreply@impact-fightacademy.de>
# Interne Benachrichtigungen bei neuer Anmeldung / fehlgeschlagener Zahlung
INTERNAL_NOTIFY_EMAIL=info@impact-fightacademy.de

# --- Basis-URL ---
# Pflicht. Wird für success_url/cancel_url der Stripe-Session verwendet.
# Wird NICHT aus dem Origin-Header abgeleitet, damit niemand die Weiterleitung
# nach der Zahlung auf eine fremde Domain umbiegen kann.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Rückweg zur Hauptwebsite (Ökosystem) ---
NEXT_PUBLIC_SITE_URL=https://impactacademyv1.netlify.app

# --- Demo-Modus ---
# true = Attrappen statt echter Dienste: keine Datenbank, keine Zahlungen,
# kein Mailversand. Daten liegen in .demo-data/db.json.
# Wird automatisch ignoriert, sobald ein sk_live_-Schluessel gesetzt ist.
DEMO_MODE=false
